{
  "name": "videostudy-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "build": "vue-tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "package:win": "npm run build && node ../scripts/dev/package/framewise-windows.mjs",
    "test:desktop": "node --test electron/*.test.cjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "simple-mind-map": "^0.14.0-fix.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "productName": "Framewise",
  "description": "Framewise classroom learning workspace",
  "license": "AGPL-3.0-only"
}
