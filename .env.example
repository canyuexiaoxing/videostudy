# Copy to .env and set a local development password. Do not commit .env.
MYSQL_ROOT_PASSWORD=change-this-local-password
MYSQL_PASSWORD=change-this-app-password
# Set a server-side key and ANALYSIS_MODE=full to enable PPT OCR, text review and image understanding.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANALYSIS_MODE=transcription
# Bounded API concurrency; set to 1 to compare against serial processing.
REVIEW_CONCURRENCY=3
PAGE_CONCURRENCY=5
MINDMAP_CONCURRENCY=3
# Use compose.gpu.yaml for NVIDIA GPU OCR and small CUDA/float16 speech transcription.
OCR_DEVICE=cpu
# Run Whisper and visual extraction/OCR together. Set 0 on constrained CPUs.
MEDIA_PARALLEL=1
