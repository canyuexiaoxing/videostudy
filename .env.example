# Copy to .env and set a local development password. Do not commit .env.
MYSQL_ROOT_PASSWORD=change-this-local-password
MYSQL_PASSWORD=change-this-app-password
# Set a server-side key and ANALYSIS_MODE=full to enable PPT OCR, text review and image understanding.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANALYSIS_MODE=transcription
